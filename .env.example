# =============================================================================
# TEMPLATE — this file IS committed to git. Never put a real secret in it.
# Copy to .env (same folder) and fill in real values there. .env is git-ignored.
# =============================================================================

# --- Database ----------------------------------------------------------------
# Supabase → Project Settings → Database → Connection string
# Read the "Which connection string" note before you paste. Port 5432, never 6543.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# --- Connection pool ----------------------------------------------------------
DB_POOL_MIN=1
DB_POOL_MAX=10

# --- Auth (Phase 2, but set it now) -------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- Super-admin seed (read once by: python -m db.migrate init) ---------------
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=CHANGE_ME_BEFORE_INIT

# --- App -----------------------------------------------------------------------
APP_ENV=development